{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnboardingMinimal",
  "version": "0.1.0",
  "identifier": "com.example.onboardingminimal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "入职指引（printer-core 接入示例）",
        "width": 800,
        "height": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrinterInstaller",
  "version": "1.0.0",
  "identifier": "com.tencent.printerinstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-new"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Printer Driver Installer",
        "width": 440,
        "height": 400,
        "resizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
